# Copy this file to .env for local development with `vercel dev`.
# In production, set these in the Vercel dashboard instead:
# Project -> Settings -> Environment Variables

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase "service_role" key (Project -> Settings -> API).
# This is a SECRET key with full database access — it must only ever
# be used server-side (inside /api functions), never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
